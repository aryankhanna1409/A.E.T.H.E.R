#!/bin/bash
# First boot: install Docker, clone the repo and start the Jenkins stack. Log: /var/log/aether-jenkins-setup.log
set -euxo pipefail
exec > >(tee -a /var/log/aether-jenkins-setup.log) 2>&1

export DEBIAN_FRONTEND=noninteractive
apt-get update
apt-get install -y docker.io docker-compose-v2 git
snap install aws-cli --classic
systemctl enable --now docker

# 2 GiB swap so a t3.small can hold the controller and a test run at the same time.
if [ ! -f /swapfile ]; then
  fallocate -l 2G /swapfile
  chmod 600 /swapfile
  mkswap /swapfile
  swapon /swapfile
  echo '/swapfile none swap sw 0 0' >> /etc/fstab
fi

if [ ! -d /opt/aether/.git ]; then
  git clone --depth 1 --branch "${repo_ref}" "${repo_url}" /opt/aether
fi

AETHER_SSM_PREFIX="${ssm_prefix}" /opt/aether/infra/jenkins/bootstrap.sh
